{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    },
    "autosana-simulator": {
      "extends": "preview",
      "environment": "production",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
